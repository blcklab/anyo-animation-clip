{
  "name": "@blcklab/anyo-animation-clip",
  "version": "0.1.1",
  "description": "Renderer-neutral animation-asset preparation contracts for Anyo with a production VRMA-to-Sekai64 retargeting adapter.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sekai64": {
      "types": "./dist/sekai64/index.d.ts",
      "import": "./dist/sekai64/index.js"
    },
    "./anyo-animation": {
      "types": "./dist/anyo-animation/index.d.ts",
      "import": "./dist/anyo-animation/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run generate:version && node scripts/build.mjs",
    "typecheck": "npm run generate:version && tsc -p tsconfig.json --noEmit --pretty false",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run typecheck && npm test && npm run verify:boundaries && npm run verify:package",
    "prepublishOnly": "npm run check",
    "generate:version": "node scripts/generate-version.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@blcklab/sekai64": ">=0.8.0-0 <0.9.0",
    "@blcklab/anyo-animation": ">=0.1.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@blcklab/anyo-animation": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blcklab/sekai64": "0.8.0-rc.33",
    "@blcklab/anyo-animation": "0.1.2",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "blcklab",
  "keywords": [
    "anyo",
    "animation",
    "vrma",
    "vrm",
    "sekai64",
    "retargeting",
    "animation-clip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blcklab/anyo-animation-clip.git"
  },
  "bugs": {
    "url": "https://github.com/blcklab/anyo-animation-clip/issues"
  },
  "homepage": "https://github.com/blcklab/anyo-animation-clip#readme"
}
